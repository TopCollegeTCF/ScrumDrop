# Скопируйте в server/.env и поменяйте при необходимости.
# Переменные окружения процесса имеют приоритет над этим файлом.

# Порт и адрес HTTP-сервера. 0.0.0.0 — чтобы открыть сайт с телефона в той же сети.
PORT=3000
HOST=0.0.0.0

# Строка подключения к PostgreSQL (совпадает с docker-compose.yml и npm run db:local).
DATABASE_URL=postgresql://scrumdrop:scrumdrop@localhost:5432/scrumdrop

# Применять миграции и сиды при старте сервера.
DB_MIGRATE_ON_START=true

# Срок жизни сессии (дни) и стоимость bcrypt.
SESSION_TTL_DAYS=30
BCRYPT_ROUNDS=11

# Стартовый бонус новому игроку (монеты).
SIGNUP_BONUS=100

# Демо-пополнение виртуальных монет без карты. В production выключите.
DEMO_TOP_UP=true
TOP_UP_MAX=1000

# Cookie только по HTTPS. По умолчанию включается при NODE_ENV=production.
# COOKIE_SECURE=true

# Если фронтенд работает на другом адресе (например, Vite на :5173), перечислите его через запятую.
# CORS_ORIGINS=http://localhost:5173

# За обратным прокси (nginx и т. п.) — число доверенных прокси, чтобы правильно определять IP.
# TRUST_PROXY=1
