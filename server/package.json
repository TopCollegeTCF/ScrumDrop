{
  "name": "scrumdrop-server",
  "version": "0.1.0",
  "private": true,
  "description": "Серверная часть ScrumDrop: аккаунты, кейсы, инвентарь, история и кошелёк",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "db:migrate": "node src/scripts/migrate.ts",
    "db:local": "node src/scripts/local-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "16.16.0-beta.19",
    "typescript": "^7.0.2"
  }
}
